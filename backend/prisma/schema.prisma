generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ca_credentials {
  id          Int      @id @default(1)
  certificate String
  private_key String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model csr_requests {
  id                  Int                   @id @default(autoincrement())
  user_id             Int
  domain              String                @db.VarChar(255)
  company             String                @db.VarChar(255)
  division            String                @db.VarChar(255)
  city                String                @db.VarChar(100)
  state               String                @db.VarChar(100)
  country             String                @db.VarChar(10)
  email               String                @db.VarChar(255)
  root_length         Int
  csr                 String
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  status              String?               @default("pending") @db.VarChar(20)
  rejection_reason    String?
  users               users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  issued_certificates issued_certificates[]
}

model issued_certificates {
  id                   Int                    @id @default(autoincrement())
  user_id              Int?
  csr_id               Int?
  domain               String                 @db.VarChar(255)
  certificate          String
  issued_at            DateTime?              @default(now()) @db.Timestamp(6)
  valid_till           DateTime?              @db.Timestamp(6)
  status               String?               @default("active") @db.VarChar(20)
  csr_requests         csr_requests?          @relation(fields: [csr_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                users?                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  revoked_certificates revoked_certificates[]
}

model revoked_certificates {
  id                  Int                 @id @default(autoincrement())
  certificate_id      Int
  revoked_at          DateTime?           @default(now()) @db.Timestamp(6)
  reason              String?
  issued_certificates issued_certificates @relation(fields: [certificate_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id                  Int                   @id @default(autoincrement())
  username            String                @unique @db.VarChar(255)
  email               String                @unique @db.VarChar(255)
  password            String                @db.VarChar(255)
  role                String?               @default("client") @db.VarChar(50)
  is_verified         Boolean?              @default(false)
  otp                 String?               @db.VarChar(6)
  otp_expiry          DateTime?             @db.Timestamp(6)
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  updated_at          DateTime?             @default(now()) @db.Timestamp(6)
  csr_requests        csr_requests[]
  issued_certificates issued_certificates[]

  @@index([email], map: "idx_users_email")
}
